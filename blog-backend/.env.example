# ======================================
# 薄荷随笔 · 后端环境变量（本地开发用）
# Render 部署时在 Dashboard 环境变量面板配置
# ======================================

# === JWT（生产一定要改成随机长字符串！） ===
JWT_SECRET=请改成一段你自己的随机长字符串，至少32位
JWT_EXPIRES_IN=7d

# === Server ===
# 本地开发 3000，Render 会自动注入 PORT
PORT=3000

# === CORS ===
# 本地开发只允许 Vite
# 生产：填前端 Netlify 完整地址，如 https://mint-blog.netlify.app
# 设为 * 允许所有源（开发调试方便，生产不建议）
CORS_ORIGIN=*

# === SQLite ===
# 本地：留空自动用项目根 ./blog.db
# Render：/data/blog.db（持久化磁盘）
DB_FILE=

# === 上传目录 ===
# 本地：留空自动用 ./uploads
# Render：/data/uploads
UPLOAD_DIR=
